# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (sin / final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://altosdecahuil.cl

# --- Mercado Pago (Tus integraciones → Credenciales de producción / prueba) ---
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones → Webhooks). Opcional pero recomendada.
MP_WEBHOOK_SECRET=
# true para usar el checkout de prueba (sandbox)
MP_USE_SANDBOX=false

# Secreto para la tarea programada /api/cron/sync (genera uno largo al azar)
CRON_SECRET=

# --- Correos (opcional, https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM="Altos de Cahuil <reservas@tudominio.cl>"
# Aquí te llega el aviso de cada reserva pagada
OWNER_EMAIL=altos.cahuil@gmail.com
